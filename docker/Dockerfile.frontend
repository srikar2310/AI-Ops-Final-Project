# Frontend: Streamlit. Talks to the backend ONLY through API_URL (REST).
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY frontend/requirements.txt .
RUN pip install -r requirements.txt

# app.py, api_client.py, pages/ and components/ (the two custom chessboards)
COPY frontend/ .

RUN useradd -m appuser && chown -R appuser /app
USER appuser

ENV API_URL=http://backend:8000
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health',timeout=3).status==200 else 1)"

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]